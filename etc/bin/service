#!/bin/bash
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/common"

command=${1:-help}
if [[ $# -gt 0 ]]; then shift; fi
case "$command" in
    start|restart)
        systemctl_app "$command"
        check_health
        compose ps
        ;;
    stop)
        systemctl_app stop
        ;;
    status)
        systemctl_app status
        compose ps --all
        ;;
    logs)
        # Native Compose flags: --tail N, --since TIME, --follow, and service names.
        compose logs "$@"
        ;;
    health)
        systemctl_app is-active --quiet
        check_health
        echo "Podcast App web and background worker are ready."
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs|health}"
        echo "Examples: $0 logs --tail 100 --follow; $0 logs web"
        [[ "$command" == help ]]
        ;;
esac
