#!/bin/sh
set -eu

# Fail with a nonzero exit code so Compose/systemd and CI see startup failures.
: "${APP_SERVICE:?APP_SERVICE is required (web, background, test, lint)}"
export PYTHONPATH=/app

case "$APP_SERVICE" in
    web|background)
        : "${DB_USER:?DB_USER is required}"
        : "${DB_PASSWORD:?DB_PASSWORD is required}"
        : "${DB_NAME:?DB_NAME is required}"
        : "${APP_SECRET_KEY:?APP_SECRET_KEY is required}"
        : "${ADMIN_PASSWORD:?ADMIN_PASSWORD is required}"
        : "${SENS_DATA_ENCRYPT_KEY:?SENS_DATA_ENCRYPT_KEY is required}"
        ;;
esac

case "$APP_SERVICE" in
    web)
        echo "Applying database migrations..."
        alembic upgrade head
        echo "Starting Podcast App web service..."
        exec uvicorn --factory src.main:make_app --host 0.0.0.0 \
            --port "${APP_PORT:-8000}" --loop uvloop --proxy-headers \
            --forwarded-allow-ips="${FORWARDED_ALLOW_IPS:-127.0.0.1}"
        ;;
    background)
        echo "Starting Podcast App background worker..."
        exec python -m src.worker
        ;;
    test)
        : "${TEST_DB_NAME:?TEST_DB_NAME must name an isolated functional test database}"
        # Fixtures create their own schema; never migrate the application DB here.
        export COVERAGE_FILE=/tmp/.coverage
        coverage run -m pytest -o cache_dir=/tmp/.pytest_cache "$@"
        exec coverage report
        ;;
    lint)
        export RUFF_CACHE_DIR=/tmp/.ruff
        black --check .
        ruff check .
        exec mypy . --show-traceback --cache-dir /tmp/.mypy_cache
        ;;
    *)
        echo "Unknown APP_SERVICE: $APP_SERVICE" >&2
        exit 1
        ;;
esac
