# Server runtime configuration. Copy to .env and fill all empty required values.
# The selected image and version belong in .version, not here.
APP_PORT=8003
SITE_URL=https://podcast.example.com
SERVICE_URL=https://podcast.example.com
APP_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# At least 32 ASCII characters; retain this key across upgrades.
SENS_DATA_ENCRYPT_KEY=
AUTH_COOKIE_SECURE=true
# Web is exposed only on host loopback; the host Nginx is the trusted proxy.
FORWARDED_ALLOW_IPS=*
LOG_LEVEL=INFO
LOG_SKIP_STATIC_ACCESS=true
API_DOCS_ENABLED=false

# External containers must share the external Docker network named storage.
DB_HOST=podcast-db
DB_PORT=5432
DB_USER=podcasts
DB_PASSWORD=
DB_NAME=podcasts
REDIS_HOST=podcast-redis
REDIS_PORT=6379
REDIS_DB=0

# Existing S3-compatible storage and bucket; these are required for startup.
S3_ENV=prod
S3_STORAGE_URL=https://s3.example.com
S3_REGION_NAME=us-east-1
S3_BUCKET_NAME=podcasts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional SMTP for invitation and password-reset mail.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
