# Shared local/server template. See INSTALL.md for server-specific values.
# Production image selection is read from .version instead.
DOCKER_IMAGE="podcast-app:latest"
APP_HOST=localhost
APP_PORT=8003
SITE_URL=http://localhost:8003
SERVICE_URL=http://localhost:8003
LOG_LEVEL=INFO
LOG_SKIP_STATIC_ACCESS=true
API_DOCS_ENABLED=true
APP_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# At least 32 ASCII characters; retain this key across upgrades.
SENS_DATA_ENCRYPT_KEY=

S3_ENV=prod
S3_STORAGE_URL=https://s3.example.com
S3_REGION_NAME=us-east-1
S3_BUCKET_NAME=podcasts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

DB_USER=podcasts
DB_PASSWORD=
DB_NAME=podcasts
DB_HOST=localhost
DB_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
TEST_DB_NAME=podcasts_test
# For local HTTP. Set true on the server with HTTPS.
AUTH_COOKIE_SECURE=false
FORWARDED_ALLOW_IPS=127.0.0.1
# APP_PLATFORM=linux/arm64
# Run make secrets to fill missing secrets; see INSTALL.md for server settings.

# Optional SMTP for invitation and password-reset mail.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
