# Non-production values only. CI supplies this file explicitly to Compose.
APP_ENV_FILE=.github/ci.env
APP_PORT=8003
APP_SECRET_KEY=ci-only-not-a-production-secret-0123456789-0123456789-0123456789-0123456789
ADMIN_PASSWORD=ci-only-password
SENS_DATA_ENCRYPT_KEY=ci-only-encryption-key-32-characters
AUTH_COOKIE_SECURE=false
DB_USER=podcasts
DB_PASSWORD=ci-only-postgres-password
DB_NAME=podcasts_ci
TEST_DB_NAME=podcasts_ci_test
DB_HOST=db
REDIS_HOST=redis
S3_ENV=dev
S3_BUCKET_NAME=podcasts-ci
S3_ACCESS_KEY_ID=ci-only-access-key
S3_SECRET_ACCESS_KEY=ci-only-secret-key
